---
// Shared top navigation. Markup is the exact inner HTML of <header class="site-nav">
// from the original static pages (sliced once into src/partials/_nav.html), injected
// verbatim. Only the wrapper class changes: the home page uses the dark, fixed variant.
import navInner from '../partials/_nav.html?raw';

interface Props {
  variant?: 'home' | 'default';
}
const { variant = 'default' } = Astro.props;
const cls = variant === 'home' ? 'site-nav on-dark home-topbar' : 'site-nav';
---
{/* transition:persist belongs HERE, on the element itself: a directive on the component tag
    is not forwarded to what the component renders unless the props are spread, so putting it
    at the call site silently did nothing. This is what survives a client-side navigation —
    the bar is never rebuilt, which is the whole point of the router. Its light/dark variant
    therefore cannot come from `cls` on a later page, so nav.js re-applies it from <body>. */}
<header class={cls} transition:persist="site-nav"><Fragment set:html={navInner} /></header>
