---
/* Three-column footer — contact, navigation, legal — over the institution seals.
 * Modelled on the team's other build, which carries information this site was
 * missing: a postal address, a contact address, the licence, and the repository
 * link (iGEM expects a repository link to be reachable from every page).
 *
 * Deliberately NOT copied across: the "Pipeline status: PASSED" badge. It points at
 * a CI pipeline that builds the other site, not this one, so it would be a claim
 * about something this build does not do.
 */
interface Props {
  safetyHref?: string;
}
const { safetyHref = 'Wet-Lab-Experiments.html#safety' } = Astro.props;

const NAV_LEFT = [
  { href: 'index.html', label: 'Home' },
  { href: 'Wet-Lab-Experiments.html', label: 'Wet Lab' },
  { href: 'Attributions.html', label: 'Team' },
];
/* Each seal links to that institution's own site. Verified rather than assumed, and the
 * result is not three English sites: HUST and the College of Life Science and Technology
 * each publish one — the college's is the address its own Chinese homepage links to — and
 * Qiming College does not publish an English site at all, so it points at the only official
 * site it has. Inventing an English URL for it would have been the wrong kind of tidy.
 *
 * The college's English site has no valid certificate for its own hostname (HUST's wildcard
 * covers one label, not two), so it is reachable over http only. */
const SEALS = [
  {
    src: 'assets/img/seal-hust.webp', w: 300, h: 234,
    alt: 'Huazhong University of Science and Technology',
    href: 'https://english.hust.edu.cn/',
  },
  {
    src: 'assets/img/seal-college.webp', w: 300, h: 300,
    alt: 'HUST College of Life Science and Technology',
    href: 'http://english.life.hust.edu.cn/',
  },
  {
    src: 'assets/img/seal-qiming.webp', w: 120, h: 120,
    alt: 'Qiming College, HUST',
    href: 'https://qiming.hust.edu.cn/',
  },
];

const NAV_RIGHT = [
  { href: 'Project-Description.html', label: 'Project' },
  { href: 'Human-Practices.html', label: 'Human Practices' },
  { href: safetyHref, label: 'AI & Safety' },
];
---
<footer class="site-footer">
  <div class="container footer-main">

    <section class="footer-col">
      <h2 class="footer-h">Contact Us</h2>
      <p class="footer-addr">
        Huazhong University of Science and Technology<br />
        1037 Luoyu Road, Hongshan District, Wuhan<br />
        Hubei Province, P.R. China 430074
      </p>
      <p><a class="footer-mail" href="mailto:igemhustchina@163.com">igemhustchina@163.com</a></p>
    </section>

    <section class="footer-col">
      <h2 class="footer-h">Navigate</h2>
      <div class="footer-nav">
        <ul>{NAV_LEFT.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
        <ul>{NAV_RIGHT.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </div>
    </section>

    <section class="footer-col">
      <h2 class="footer-h">Legal</h2>
      <p class="footer-copy">© <span id="year"></span> iGEM HUST-China</p>
      <p>Licensed under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license noopener" target="_blank">CC BY 4.0</a></p>
      <p><a href="https://gitlab.igem.org/2026/hust-china" rel="noopener" target="_blank">Repository on iGEM GitLab</a></p>
    </section>

  </div>

  <div class="footer-institutions-band">
    <div class="container footer-institutions">
      {SEALS.map((s) => (
        <a class="footer-seal-link" href={s.href} target="_blank" rel="noopener noreferrer"
           aria-label={`${s.alt} (opens in a new tab)`}>
          <img class="footer-seal" src={s.src} width={s.w} height={s.h}
               loading="lazy" decoding="async" alt={s.alt} />
        </a>
      ))}
    </div>
  </div>
</footer>
