---
// The single shared shell for every page. Reproduces the original <head> order and
// the original end-of-body script order:
//   <script> year </script>  ->  nav.js  ->  (home.js | Attributions card script)
//
// `headExtra` is raw HTML sliced from each source page's <head> (the home.css <link>
// on the home page; the page-scoped <style> block on Project / Wet Lab / Attributions;
// the <meta refresh> on the two AI redirect stubs). It is injected untouched so those
// styles are NOT run through Astro's scoping/bundling.
import { ClientRouter } from 'astro:transitions';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteSearch from '../components/SiteSearch.astro';

interface Props {
  title: string;
  description?: string | null;
  bodyClass?: string;
  navVariant?: 'home' | 'default';
  safetyHref?: string;
  headExtra?: string;
}
const {
  title,
  description = null,
  bodyClass = '',
  navVariant = 'default',
  safetyHref = 'Wet-Lab-Experiments.html#safety',
  headExtra = '',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title set:html={title}></title>
  <link rel="icon" type="image/png" sizes="32x32" href="assets/img/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="assets/img/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="assets/img/favicon-48.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="assets/img/favicon-180.png" />
  <meta name="theme-color" content="#0e6e6a" />
  {description && <meta name="description" content={description} />}
  {/* Self-hosted, so there is no third-party round trip before the first character can be
      shaped — and, more to the point, no swap. Loading these from Google with display=swap
      meant every page painted with fallback metrics and then re-laid-out when the real faces
      arrived, which moved anchor landings out from under the reader and made every
      measurement taken during that window describe a layout that no longer existed.

      Only the four faces the first screen actually needs are preloaded: body text, the two
      weights bold text and h3/h4 use, and the display face the h1 and h2 are set in. The
      rest are fetched on demand, and unicode-range keeps latin-ext and greek off the wire
      entirely unless the page contains those characters. crossorigin is required on a font
      preload even same-origin — without it the file is fetched twice. */}
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/inter-400-latin.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/inter-600-latin.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/inter-700-latin.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/cormorant-garamond-700-latin.woff2" />
  <link rel="stylesheet" href="assets/css/fonts.css" />
  <link rel="stylesheet" href="assets/css/style.css" />
  {/* Client-side routing. Navigation swaps the document in place instead of tearing it down
      and rebuilding it, which is what actually removes the flash between pages — the nav bar
      is not re-created, the fonts are not re-applied, and scroll state is the router's to
      manage rather than the browser's to guess.

      Everything downstream follows from one rule: an element carrying transition:persist
      survives the swap, so listeners bound to it must be bound ONCE; an element that does
      not survive takes its listeners with it and can be bound freely on every page; and
      anything bound to window or document outlives all of it and must be bound once. Each
      of the four scripts below is written against that rule and initialises from
      astro:page-load, which fires on the first load as well as on every navigation. */}
  <ClientRouter />
  {headExtra && <Fragment set:html={headExtra} />}
</head>
{/* The nav variant is on the body because the nav element itself is persisted across
    navigations and therefore cannot carry a per-page class of its own; nav.js reads this
    and re-applies the right one after each swap. */}
<body class={bodyClass || undefined} data-nav={navVariant}>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot name="body-top" />
  <SiteNav variant={navVariant} />
  <div id="main" tabindex="-1"></div>
  <slot />
  <SiteFooter safetyHref={safetyHref} />
  <SiteSearch />
  <script is:inline>document.getElementById("year").textContent = new Date().getFullYear();</script>
  <script is:inline src="assets/js/nav.js"></script>
  <script is:inline src="assets/js/pagenav.js"></script>
  <script is:inline src="assets/js/search.js"></script>
  {/* Loaded on every page, not just the home page. Under client-side routing a script that
      only exists in one page's markup is never fetched if the visitor arrives anywhere else
      first, and then arriving at the home page gets a page with no behaviour at all. Both
      of these already do nothing when the markup they drive is absent. */}
  <script is:inline src="assets/js/home.js"></script>
  <script is:inline src="assets/js/butterfly.js"></script>
  <slot name="body-end" />
</body>
</html>
