---
import BaseLayout from '../layouts/BaseLayout.astro';
import rawBody from '../partials/Attributions.body.html?raw';
import headExtra from '../partials/Attributions.head.html?raw';
import {
  WET_LAB, DRY_LAB, HUMAN_PRACTICES, ADVISORS, PIS, photoFor, type Member,
} from '../data/roster';

/* The roster is rendered here, at build time, from src/data/roster.ts — real ids, real
 * headcounts, real portraits — so the cards are in the HTML rather than appearing once a script
 * has run. It used to be five separate grids, one per sub-team; it is one grid now, with the
 * sub-teams as filters over it, so the page can answer "who is on this team" as well as "who is
 * in the wet lab". Every card carries the group it belongs to and roster.js does the rest.
 *
 * With JavaScript off, nothing is hidden and the whole roster shows. That is the right answer,
 * not a degraded one. */
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

/* The groups, in the order they are offered. `key` is what the cards carry and the tabs match
   on; `note` is the one line that belongs to that group and nothing else — the Dry Lab's is the
   important one, because it says plainly that per-person attribution has not been published. */
const GROUPS = [
  { key: 'wet',  label: 'Wet Lab',         members: WET_LAB,         note: '' },
  { key: 'dry',  label: 'Dry Lab',         members: DRY_LAB,
    note: 'The modelling itself is documented in full on Project: Model — optical (§1), synthetic-biology (§2) and protein (§3). Which member led which section has not been published, so no assignment is claimed here.' },
  { key: 'hp',   label: 'Human Practices', members: HUMAN_PRACTICES, note: '' },
  { key: 'adv',  label: 'Advisors & PIs',  members: [...ADVISORS, ...PIS], note: '' },
];

function card(m: Member, group: string): string {
  const quote = m.quote
    ? `<div class="tc-v quote">&ldquo;${esc(m.quote)}&rdquo;</div>`
    : `<div class="tc-v quote">Peer note pending.</div>`;
  return (
    `<div class="team-card" data-team="${group}" tabindex="0">` +
      `<img class="tc-photo" src="${photoFor(m.id)}" alt="${esc(m.name)}" loading="lazy" decoding="async">` +
      `<div class="name-plate"><div class="tc-name">${esc(m.name)}</div><div class="tc-role">${esc(m.role)}</div></div>` +
      `<div class="info-overlay">` +
        `<div class="tc-name2">${esc(m.name)}</div><div class="tc-role2">${esc(m.role)}</div>` +
        `<div class="tc-k">Contribution</div><div class="tc-v">${esc(m.contribution)}</div>` +
        `<div class="tc-k">What others say</div>${quote}` +
      `</div>` +
    `</div>`
  );
}

const total = GROUPS.reduce((n, g) => n + g.members.length, 0);
const gridHtml = GROUPS.map((g) => g.members.map((m) => card(m, g.key)).join('')).join('');
const tabsHtml =
  `<button class="roster-tab is-on" type="button" role="tab" aria-selected="true" data-team="all">` +
    `All <span class="rt-n">${total}</span></button>` +
  GROUPS.map((g) =>
    `<button class="roster-tab" type="button" role="tab" aria-selected="false" data-team="${g.key}">` +
      `${esc(g.label)} <span class="rt-n">${g.members.length}</span></button>`).join('');
const notesJson = JSON.stringify(Object.fromEntries(GROUPS.map((g) => [g.key, g.note])));

let body = rawBody
  .replace('<div class="team-grid" id="roster-grid"></div>',
           `<div class="team-grid" id="roster-grid">${gridHtml}</div>`)
  .replace('<div class="roster-tabs" role="tablist" aria-label="Filter the roster by sub-team"></div>',
           `<div class="roster-tabs" role="tablist" aria-label="Filter the roster by sub-team">${tabsHtml}</div>`)
  .replace('<span class="credit-tag" id="roster-count"></span>', `<span class="credit-tag">${total} people</span>`)
  .replace('<p class="section-note" id="roster-note"></p>',
           `<p class="section-note" id="roster-note" hidden data-notes='${notesJson.replace(/'/g, "&#39;")}'></p>`);
---

<BaseLayout title="Team | Diǎn Cuì iGEM Wiki" headExtra={headExtra}
  rail={false}>
  <Fragment set:html={body} />
</BaseLayout>
