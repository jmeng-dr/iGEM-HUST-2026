---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../partials/index.body.html?raw';
import headExtra from '../partials/index.head.html?raw';
---
<BaseLayout
  title="Diǎn Cuì | iGEM Team Wiki"
  description="An engineered, cruelty-free echo of Diǎn Cuì (点翠) kingfisher-feather structural color, built from waste cotton, bacterial cellulose, and reflectin protein."
  bodyClass="home"
  navVariant="home"
  headExtra={headExtra}
>
  <Fragment slot="body-top">
    <div id="cursor-orb" aria-hidden="true"></div>
    <div id="bg-wash" aria-hidden="true"></div>
    <!-- The medallion, hung off the page's left edge: its centre sits exactly on x=0 so
         only the right half is ever on screen. It used to live inside .wheel-sticky, which
         meant it could only ever be where that box was; it is page-level and viewport-fixed
         now so home.js can hold it still after the modules are done while the page keeps
         scrolling under it. Rotates 90 degrees per module. The four arcs are fixed at
         rotate(i*90) inside the dial, so whichever one is active always lands at the same
         screen position while the artwork turns underneath it. Decorative only — the
         wheel-stop list is still the indicator. -->
    <div class="wheel-dial-wrap" aria-hidden="true">
      <div class="dial" id="wheelDial">
        <img class="dial-core" src="/assets/img/medallion.webp" alt="" width="1000" height="716" decoding="async">
        <svg class="dial-arcs" viewBox="0 0 200 200" aria-hidden="true">
          <circle class="dial-arc" cx="100" cy="100" r="94" pathLength="100" transform="rotate(-45 100 100)"></circle>
          <circle class="dial-arc" cx="100" cy="100" r="94" pathLength="100" transform="rotate(45 100 100)"></circle>
          <circle class="dial-arc" cx="100" cy="100" r="94" pathLength="100" transform="rotate(135 100 100)"></circle>
          <circle class="dial-arc" cx="100" cy="100" r="94" pathLength="100" transform="rotate(225 100 100)"></circle>
        </svg>
      </div>
    </div>
    <!-- Three copies of one file (one request, one decode), each clipped to a different
         part of the artwork so the wings can hinge independently of the body. The body
         is last so it paints over the wings' inner edges. See "9. BUTTERFLY WING FLAP"
         in home.css for the geometry. -->
    <div id="butterfly" aria-hidden="true">
      <div class="bf-part bf-wing bf-wing-l">
        <img src="/assets/img/butterfly.webp" alt="" width="800" height="747" decoding="async">
        <i class="bf-shade"></i>
      </div>
      <div class="bf-part bf-wing bf-wing-r">
        <img src="/assets/img/butterfly.webp" alt="" width="800" height="747" decoding="async">
        <i class="bf-shade"></i>
      </div>
      <div class="bf-part bf-body">
        <img src="/assets/img/butterfly.webp" alt="" width="800" height="747" decoding="async">
        <i class="bf-shade"></i>
      </div>
    </div>
  </Fragment>

  <Fragment set:html={body} />

  <Fragment slot="body-end">
    <script is:inline src="/assets/js/home.js"></script>
    <script is:inline src="/assets/js/butterfly.js"></script>
  </Fragment>
</BaseLayout>
