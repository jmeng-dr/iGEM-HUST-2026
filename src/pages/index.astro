---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../partials/index.body.html?raw';
import headExtra from '../partials/index.head.html?raw';
---
<BaseLayout
  title="Diǎn Cuì | iGEM Team Wiki"
  description="An engineered, cruelty-free echo of Diǎn Cuì (点翠) kingfisher-feather structural color, built from waste cotton, bacterial cellulose, and reflectin protein."
  bodyClass="home"
  navVariant="home"
  headExtra={headExtra}
>
  <Fragment slot="body-top">
    <div id="bg-wash" aria-hidden="true"></div>
    <!-- The medallion, hung off the page's left edge: its centre sits exactly on x=0 so
         only the right half is ever on screen. It used to live inside .wheel-sticky, which
         meant it could only ever be where that box was; it is page-level and viewport-fixed
         now so home.js can hold it still after the modules are done while the page keeps
         scrolling under it. Rotates 90 degrees per module. The four arcs are fixed at
         rotate(i*90) inside the dial, so whichever one is active always lands at the same
         screen position while the artwork turns underneath it. Decorative only — the
         wheel-stop list is still the indicator. -->
    <div class="wheel-dial-wrap" aria-hidden="true">
      <div class="dial" id="wheelDial">
        <!-- FIVE pieces, not one painting: a hub and four quarter sectors, drawn on one
             artboard and delivered as separate files. That is what lets the sector currently
             being talked about be lifted out of the others, which a flat image cannot do.

             Each sector was normalised to a common square whose centre IS the wheel's centre
             and whose radius is the same in all four, so the only thing that distinguishes
             them here is a rotation of ninety degrees. The geometry was recovered from the
             artwork rather than guessed: a circle fit to each outer arc gave radii within 2%
             of each other and every sector pointing straight up, and the assembled ring
             covers 99.6% of 360 degrees with no gap wider than half a degree.

             AVIF first, as before. All five together are 212 KB, against 301 KB for the
             single medallion they replace. -->
        <picture><source srcset="assets/img/dial-1.avif" type="image/avif">
          <img class="dial-sector" data-sector="0" src="assets/img/dial-1.webp" alt="" width="1400" height="1400" decoding="async"></picture>
        <picture><source srcset="assets/img/dial-2.avif" type="image/avif">
          <img class="dial-sector" data-sector="1" src="assets/img/dial-2.webp" alt="" width="1400" height="1400" decoding="async"></picture>
        <picture><source srcset="assets/img/dial-3.avif" type="image/avif">
          <img class="dial-sector" data-sector="2" src="assets/img/dial-3.webp" alt="" width="1400" height="1400" decoding="async"></picture>
        <picture><source srcset="assets/img/dial-4.avif" type="image/avif">
          <img class="dial-sector" data-sector="3" src="assets/img/dial-4.webp" alt="" width="1400" height="1400" decoding="async"></picture>
        <picture><source srcset="assets/img/dial-axis.avif" type="image/avif">
          <img class="dial-hub" src="assets/img/dial-axis.webp" alt="" width="1400" height="1400" decoding="async"></picture>
      </div>
    </div>
    <!-- Three copies of one file (one request, one decode), each clipped to a different
         part of the artwork so the wings can hinge independently of the body. The body
         is last so it paints over the wings' inner edges. See "9. BUTTERFLY WING FLAP"
         in home.css for the geometry. -->
    <div id="butterfly" aria-hidden="true">
      <div class="bf-part bf-wing bf-wing-l">
        <img src="assets/img/butterfly.webp" alt="" width="800" height="747" decoding="async">
        <i class="bf-shade"></i>
      </div>
      <div class="bf-part bf-wing bf-wing-r">
        <img src="assets/img/butterfly.webp" alt="" width="800" height="747" decoding="async">
        <i class="bf-shade"></i>
      </div>
      <div class="bf-part bf-body">
        <img src="assets/img/butterfly.webp" alt="" width="800" height="747" decoding="async">
        <i class="bf-shade"></i>
      </div>
    </div>
  </Fragment>

  <Fragment set:html={body} />

</BaseLayout>
